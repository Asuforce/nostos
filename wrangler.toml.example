name = "nostos"
main = "build/worker/shim.mjs"
compatibility_date = "2025-01-01"

[build]
command = "cargo install -q --locked worker-build --version 0.8.0 && worker-build --release"

# nsreach切替待ち。HTTP gateは既定OFFを維持。
[triggers]
crons = []

# 秘密情報はここに書かない。
# 本番: wrangler secret put SLACK_BOT_TOKEN / SLACK_CHANNEL_ID
# ローカル: .dev.vars.example を .dev.vars にコピーして編集
